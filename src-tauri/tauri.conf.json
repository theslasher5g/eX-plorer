{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eX-plorer",
  "version": "0.1.0",
  "identifier": "com.explorer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "eX-plorer",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: http://shellimg.localhost shellimg:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "eX-plorer",
    "shortDescription": "Moderner Datei-Explorer für Windows",
    "longDescription": "Datei-Explorer mit Listen-, Kachel-, Spalten- und Baumansicht, Tabs, OneDrive- und Netzlaufwerk-Unterstützung.",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "de-DE"
      }
    }
  }
}
